library(nlme)
library(performance)
library(tidyverse)
library(ggplot2)
library(effects)
library(effects)
effects_data <- as.data.frame(effect("t_pre:intervention", modelAllRandom))
p <- ggplot(effects_data, aes(x = t_pre, y = fit, group = intervention, color = intervention)) +
# Add the fitted mean line
geom_line(linewidth = 1.2) +
# Add the confidence interval ribbon
geom_ribbon(aes(ymin = lower, ymax = upper, fill = intervention), alpha = 0.2) +
# Add the raw data points (optional, but good for context)
# You need to manually add the raw data points to the graph
# geom_point(data = data,
#            aes(x = t_pre, y = relativeNumberOfMethodLengthViolations, color = intervention),
#            alpha = 0.1) +
labs(
title = "Model Predicted Relative Violations Over Time (by Intervention Group)",
x = "Time Pre-Intervention (t_pre)",
y = "Predicted Relative Number of Violations",
color = "Intervention Group",
fill = "Intervention Group"
) +
theme_minimal(base_size = 14) +
scale_color_brewer(palette = "Set1") +
scale_fill_brewer(palette = "Set1")
# Print the plot
print(p)
