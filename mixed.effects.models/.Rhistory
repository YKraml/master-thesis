ymin <- min(newdata$lower)   # CI lower bound
ymax <- max(newdata$upper)   # CI upper bound
# Expand by a factor of 2
yrange <- ymax - ymin
ymin2 <- ymin - yrange / 2
ymax2 <- ymax + yrange / 2
# ---- Plot with confidence band ----
plot(
newdata$time, newdata$pred, type = "l",
xlab = "Time", ylab = "Predicted metric",
main = "Predicted metric with 95% CI",
ylim = c(ymin2, ymax2)
)
# ---- Plot with confidence band ----
plot(
newdata$time, newdata$pred, type = "l",
xlab = "Time", ylab = "Predicted averageFileLoc",
main = "Predicted averageFileLoc with 95% CI",
xlim = c(-800, 800),
ylim = c(ymin2, ymax2)
)
# ---- Plot with confidence band ----
plot(
newdata$time, newdata$pred, type = "l",
xlab = "Time", ylab = "Predicted averageFileLoc",
main = "Predicted averageFileLoc with 95% CI",
xlim = c(-800, 800),
ylim = c(ymin2, ymax2)
)
