model <- lme(
fixed = averageFileLoc ~ 1 + t_pre + t_post + intervention,
data = data,
random = ~ 1| id,
method = "ML",
control = lmeControl(opt = "optim")
)
summary(model)
VarCorr(model)
plot(ranef(model))
plot_predicted(data, model)
